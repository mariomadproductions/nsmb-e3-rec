# ROM related files
*.nds
*.sav
*.sav.*

# Original ROM data and build output
/backup
/build

# Written by `nsmbtool reference sync` from nsmbref.lock, and holding an
# absolute path into this machine's store. The lock is what gets committed.
/.ncpatcher.env

# Big Star Editor's choices for this checkout, including where this machine
# keeps the clean ROM.
/.big-star-workspace.json

# The converted Nitro SDK headers the old build kept here. NSMB_NITRO_ROOT
# names them now.
/code/include/

# VS Code
/.vscode

# Operating system files
*.lnk

# Release files
*.xdelta

#Python
/.venv/
